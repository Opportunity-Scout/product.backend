generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SearchProfileStatus {
  active
  paused
  archived
}

enum UserRole {
  user
  admin
}

model User {
  id                 String   @id
  telegramUserId     String   @unique @map("telegram_user_id")
  telegramUsername   String?  @map("telegram_username")
  role               UserRole @default(user)
  searchProfileLimit Int      @default(1) @map("search_profile_limit")
  createdAt          DateTime @map("created_at")
  updatedAt          DateTime @map("updated_at")

  @@map("users")
}

model SearchProfile {
  id            String              @id
  userId        String              @map("user_id")
  name          String
  description   String?
  status        SearchProfileStatus
  preferences   Json
  createdAt     DateTime            @map("created_at")
  updatedAt     DateTime            @map("updated_at")
  lastMatchedAt DateTime?           @map("last_matched_at")

  @@index([userId])
  @@map("search_profiles")
}
